{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../.desktop-build/node.exe": "node.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
