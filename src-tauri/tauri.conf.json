{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fortis Demo",
  "version": "0.1.0",
  "identifier": "ru.fortis.demo",
  "build": {
    "frontendDist": "../desktop/splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fortis Demo",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../.desktop-build/server/": "server/"
    }
  }
}
